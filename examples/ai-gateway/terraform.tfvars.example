# Identity: Choose an unused prefix and an existing workspace UUID.
name_prefix  = "tf-gateway-demo"
workspace_id = "existing-workspace-uuid"

# Connections: Use provider-family UUIDs from the Gateway catalog.
upstreams = {
  openai = {
    ai_provider_id = "openai-provider-family-uuid"
  }
}

# Targets: Replace these with two models enabled on your integration.
primary_upstream = "openai"
primary_model    = "gpt-4o-mini"
secondary_model  = "gpt-4.1-mini"

# Credentials: Load TF_VAR_upstream_api_keys as JSON through your credential store.
# Optional features: Read platform.md before enabling additional resources.
