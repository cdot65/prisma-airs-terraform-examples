# Identity: Replace these names with your dedicated trusted-private-repo runner.
- !policy
  id: apps
  body:
    - !host
      id: system:serviceaccount:terraform-ci:terraform-runner
- !grant
  role: !group conjur/authn-jwt/kubernetes/apps
  members: !host apps/system:serviceaccount:terraform-ci:terraform-runner
- !policy
  id: data/prisma-airs-terraform/my-tenant
  body:
    - &tenant-vars
      - !variable management/client-id
      - !variable management/client-secret
      - !variable management/tsg-id
      - !variable backend/access-key-id
      - !variable backend/secret-access-key
    - !group consumers
    - !permit
      role: !group consumers
      privilege: [read, execute]
      resource: *tenant-vars
- !grant
  role: !group data/prisma-airs-terraform/my-tenant/consumers
  members: !host apps/system:serviceaccount:terraform-ci:terraform-runner
